<?xml version="1.0" encoding="utf-8"?>
<!--
    DISEÑO DE LA PANTALLA PRINCIPAL
    Estructura (de arriba a abajo):
      Título -> instrucciones -> selector de tamaño -> movimientos + tiempo
      -> TABLERO (ocupa todo el espacio libre) -> botones Reiniciar / Nueva partida

    El FrameLayout raíz (id "main") recibe el padding de las barras del sistema
    desde MainActivity (edge-to-edge).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/texto"
            android:textSize="30sp"
            android:textStyle="bold" />

        <!-- Instrucciones -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/instrucciones"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <!-- Selector de tamaño (MEJORA: 3x3, 4x4, 5x5) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:labelFor="@+id/spinnerTamano"
                android:text="@string/etiqueta_tamano"
                android:textColor="@color/texto"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/spinnerTamano"
                android:layout_width="wrap_content"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- Marcador: movimientos a la izquierda, tiempo a la derecha (MEJORA) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMovimientos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/movimientos_inicial"
                android:textColor="@color/texto"
                android:textSize="18sp" />

            <!-- android:format: "%s" se sustituye por el tiempo MM:SS -->
            <Chronometer
                android:id="@+id/cronometro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format="@string/formato_tiempo"
                android:textColor="@color/texto"
                android:textSize="18sp" />
        </LinearLayout>

        <!--
            Contenedor del tablero: height="0dp" + layout_weight="1" significa
            "ocupa todo el alto que sobre". Dentro, el GridLayout se centra y
            MainActivity calcula el tamaño de las casillas para que sean cuadradas.
        -->
        <FrameLayout
            android:id="@+id/contenedorTablero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <!-- Los botones se añaden desde el código (crearTablero) -->
            <GridLayout
                android:id="@+id/gridTablero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Botones de control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- REINICIAR: color rojo para diferenciarlo claramente -->
            <Button
                android:id="@+id/btnReiniciar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/boton_reiniciar"
                android:text="@string/reiniciar"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnNuevaPartida"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/boton_nueva"
                android:text="@string/nueva_partida"
                android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
